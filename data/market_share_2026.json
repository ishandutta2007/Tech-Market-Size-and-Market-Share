  "highlights": [
    {
      "icon": "🤖",
      "title": "The Generative AI \"Bifurcation\" (Consumer vs. Enterprise)",
      "text": "While OpenAI maintains leadership in direct consumer subscriptions (~60%+ of web AI traffic), Anthropic (Claude) has surged to capture ~32-38% of enterprise API / coding spend (as tracked by Menlo Ventures and Ramp data), closely rivaling OpenAI in business revenue. Google Gemini captures ~18.5% through enterprise Workspace & GCP integration."
    },
    {
      "icon": "🦾",
      "title": "Physical AI & Robotics Frontier",
      "text": "Established industrial automation leaders (FANUC, ABB, KUKA, Yaskawa) and medical robotics (Intuitive Surgical) anchor current market revenue (~$65B), while the rapid maturation of Vision-Language-Action (VLA) foundation models has ignited commercial humanoid and warehouse logistics deployments across Tesla (Optimus), Amazon Robotics, Boston Dynamics, Figure AI, and Unitree."
    },
    {
      "icon": "⚛️",
      "title": "Quantum Computing Inflection",
      "text": "The quantum computing ecosystem (~$1.8B revenue) is dominated by cloud-accessible quantum QPUs and hybrid algorithms, led by IBM Quantum alongside specialized hardware innovators (IonQ, Quantinuum, D-Wave, Rigetti) and cloud platforms (AWS Braket, Azure Quantum, Google Quantum AI)."
    },
    {
      "icon": "🇨🇳",
      "title": "China's Frontier AI Landscape",
      "text": "Beyond open-weights leader DeepSeek, China's top foundation model startups—notably Zhipu AI (GLM), MiniMax (global consumer/voice apps), and Moonshot AI (Kimi's long-context breakthroughs)—collectively command ~10-12% of the global foundation model market."
    },
    {
      "icon": "⛓️",
      "title": "Web3 Asset Scale vs. Cash-Flow Capture",
      "text": "While crypto asset market cap spans ~$3.0 Trillion with trillions in turnover, direct platform/protocol fee capture stands at ~$38 Billion, concentrated in centralized liquidity hubs (Binance, Coinbase, OKX), stablecoin reserve rails, and Layer 1/2 gas fees."
    },
    {
      "icon": "🎯",
      "title": "Digital Advertising Realignment",
      "text": "Meta and Google now each control ~26-27% of global digital advertising, with Meta surging due to AI-driven ad performance (Advantage+). Meanwhile, ByteDance (TikTok + Douyin) and Amazon Ads have expanded significantly to claim ~8% and ~9% global shares respectively."
    },
    {
      "icon": "🛍️",
      "title": "E-Commerce GMV vs. Platform Revenue & SaaS Enablement",
      "text": "Global e-commerce throughput (~$6.3T B2C GMV) is led by Alibaba (~20.5% GMV), Amazon (~12.5% GMV), and PDD/Temu (~10.5% GMV). However, direct platform revenue recognition diverges sharply: 1P retailers book gross product sales, 3P marketplaces capture ~5-15% take-rate fees, and commerce SaaS enablers (Shopify with ~$250B+ merchant GMV) monetize via subscription and fintech solutions (~$11B–$13B SaaS revenue), avoiding double-counting between merchant GMV throughput and corporate software revenue."
    },
    {
      "icon": "☁️",
      "title": "Cloud & AI Hyperscaling",
      "text": "The Cloud Infrastructure (IaaS/PaaS) \"Big Three\" (AWS, Azure, GCP) command ~62% of enterprise cloud spend, with Azure & GCP closing the gap on AWS via generative AI workloads."
    },
    {
      "icon": "💻",
      "title": "PC Consolidation",
      "text": "The \"Big 3\" (Lenovo, HP, and Dell) command ~60% of the entire PC hardware market, while Apple Mac captures ~9% volume with a significantly higher premium ASP (Average Selling Price)."
    }
  ]
